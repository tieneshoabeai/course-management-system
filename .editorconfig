root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Formatting cho Node.js/Web (2 spaces)
[*.{js,jsx,ts,tsx,json,yml,yaml,md}]
indent_style = space
indent_size = 2

# Formatting cho Python (4 spaces)
[*.py]
indent_style = space
indent_size = 4
